generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WishlistItem {
  id          String   @id @default(cuid())
  url         String
  title       String
  description String?
  image       String?
  siteName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}